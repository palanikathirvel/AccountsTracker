# MongoDB Cloud (Atlas) Configuration
# Replace with your MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/accountant_tracker?retryWrites=true&w=majority
MONGODB_DATABASE=accountant_tracker

# Server Configuration
SERVER_PORT=8080

# Scheduler Configuration (overdue check rate in milliseconds: 60000 = 60s)
SCHEDULER_OVERDUE_CHECK_RATE=60000
SCHEDULER_ENABLED=true

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api

